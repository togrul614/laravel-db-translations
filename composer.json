{
    "name": "globalsoft/laravel-db-translations",
    "description": "Database-backed translation manager for Laravel admin panels — publishable views, configurable authorization and languages, drop-in Translator loader.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "translations", "localization", "admin", "i18n"],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/translation": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Globalsoft\\DbTranslations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Globalsoft\\DbTranslations\\TranslationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
