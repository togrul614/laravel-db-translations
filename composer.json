{
    "name": "togrul614/laravel-db-translations",
    "description": "Database-backed translation manager for Laravel admin panels — publishable views, configurable authorization and languages, drop-in Translator loader.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "translations", "localization", "admin", "i18n"],
    "homepage": "https://github.com/togrul614/laravel-db-translations",
    "authors": [
        {
            "name": "Togrul",
            "homepage": "https://github.com/togrul614"
        }
    ],
    "support": {
        "issues": "https://github.com/togrul614/laravel-db-translations/issues",
        "source": "https://github.com/togrul614/laravel-db-translations"
    },
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/translation": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Togrul614\\DbTranslations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Togrul614\\DbTranslations\\TranslationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
